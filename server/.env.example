# AptiCore Server Environment Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/apticore
FRONTEND_ORIGIN=http://localhost:5173

# Authentication & Session Security
SESSION_SECRET=apticore-dev-session-secret-key-32charsmin!
SESSION_COOKIE_NAME=apticore_session
SESSION_MAX_AGE_DAYS=7

# File Storage & Limits
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads/resumes

# Optional AI Configuration for Grounded Question Generation
# Supported providers: gemini | openai | groq | mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Optional Email Provider Configuration (resend | smtp | console)
EMAIL_PROVIDER=console
EMAIL_FROM=AptiCore Support <support@apticore.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Optional WebRTC STUN/TURN Configuration
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# Photorealistic AI Video Interview Provider (heygen | tavus | simli | none)
AVATAR_PROVIDER=heygen
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
SIMLI_API_KEY=
